{
  "name": "slowgrap",
  "private": true,
  "version": "1.3.0",
  "scripts": {
    "build": "npm run fonts && esbuild src/popup.jsx --bundle --minify --outfile=popup.js --define:process.env.NODE_ENV=\\\"production\\\"",
    "fonts": "node -e \"for (const f of ['inter','manrope']) require('fs').copyFileSync('node_modules/@fontsource-variable/'+f+'/files/'+f+'-latin-wght-normal.woff2',f+'.woff2')\"",
    "watch": "npm run build -- --watch"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
